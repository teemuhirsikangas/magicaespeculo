# ============================================================================
# SPOT PRICE & EVU SETTINGS (used by spot_prices.py)
# Controls when heat pump EVU (compressor block) is enabled based on spot price
# ============================================================================

# EVU Enable Logic: heating allowed if RANK <= CHEAPESTHOURS OR price <= ALLOWPRICE
CHEAPESTHOURS = 8     # Allow heating during X cheapest hours of day (1-24). Set 24 to always allow
ALLOWPRICE = 0.05     # Always allow heating if spot price <= this (EUR/kWh, e.g. 0.05 = 5 snt)

# Comfort price limit - published to MQTT for thermia.py to use
COMFORTPRICE = 0.05   # thermia.py enables comfort heating (+2°C) when spot <= this (EUR/kWh)

# Transfer price (siirtohinta) - for TotalPrice display calculation only, not used in heating logic
TRANSFERPRICEDAY = 0.0736     # Day tariff 07:00-22:00 (EUR/kWh)
TRANSFERPRICENIGHT = 0.0559   # Night tariff 22:00-07:00 (EUR/kWh)
ALLOWED_START = "22:00"       # Night tariff starts (for transfer price calc)
ALLOWED_STOP = "07:00"        # Night tariff ends (for transfer price calc)

# Monthly fees for total cost display
MONTHLYFEESPERHOUR = (39.58 + 5.00) / 730  # (Elenia + Helen monthly fees) / hours per month

# TIP: For fixed electricity contract, manually set CHEAPESTHOURS=24 and COMFORTPRICE=0.50
#      to allow heating 24h and always enable comfort mode during allowed time windows

# ============================================================================
# THERMIA HEAT PUMP SETTINGS (used by thermia.py)
# Controls comfort vs eco mode based on time windows and conditions
# ============================================================================

# Season definitions - determines which time window to use
SUMMER_START_MONTH = 4    # Summer starts April 1
SUMMER_START_DAY = 1
WINTER_START_MONTH = 10   # Winter starts October 1
WINTER_START_DAY = 1

# Time windows when COMFORT heating is allowed (thermia.py)
# Outside these windows: ECO mode (lower target temp)
SUMMER_ALLOWED_START = "22:00"   # Summer: comfort allowed 22:00-07:00
SUMMER_ALLOWED_STOP = "07:00"
WINTER_ALLOWED_START = "22:00"   # Winter: comfort allowed 22:00-07:00 (night)
WINTER_ALLOWED_STOP = "07:00"

# Target temperatures for heat pump
TARGET_TEMP = 20          # COMFORT mode target (°C)
ECO_TEMP = 19             # ECO mode target (°C)

# Safety limits
INTEGRAL_LIMIT = -150     # Don't enable comfort if integral < this (prevents aux heater 3kW)
COMFORTDISABLETEMP = 10   # Disable comfort heating if outdoor temp > this (summer)

